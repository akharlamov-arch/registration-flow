# `npm run dev` answers as both hosts (PUBLIC-HOSTS-02):
#   http://localhost:5173         onboarding (lead form, #/setup, #/relink, …)
#   http://portal.localhost:5173  the customer portal and the tutorials
# Set both to the same origin (in .env.local) for the one-host layout of the
# GitHub Pages preview instead: the portal under #/portal.
VITE_ONBOARDING_ORIGIN=http://localhost:5173
VITE_PORTAL_ORIGIN=http://portal.localhost:5173
